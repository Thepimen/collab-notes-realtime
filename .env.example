# =============================================================================
# CollabNotes Realtime — Environment Configuration (.env.example)
# =============================================================================
# OPTIONAL FOR LOCAL EVALUATION:
# If left unconfigured, CollabNotes automatically boots in Zero-Config Local Mode
# with seeded accounts, PostgreSQL RLS enforcement, OCC Compare-And-Swap versioning,
# tab-isolated sessions (?as=admin|editor|viewer), and live BroadcastChannel sync.
#
# PRODUCTION / SUPABASE CLOUD MODE:
# Copy this file to `.env.local`, execute `database/schema.sql` + `database/seed.sql`
# in your Supabase SQL Editor, and provide your project URL and anon public key:
# =============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-jwt-key
NEXT_PUBLIC_ENABLE_DEMO_FALLBACK=true
