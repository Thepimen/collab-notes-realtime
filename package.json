{
  "name": "collab-notes-realtime",
  "version": "1.0.0",
  "private": true,
  "description": "Real-Time Collaborative Notes Web Application with Next.js App Router, Supabase (PostgreSQL RLS + JSONB + Realtime WebSockets), and Optimistic Concurrency Control (OCC).",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "test": "node --test tests/concurrency-occ.test.mjs",
    "test:concurrency": "node --test tests/concurrency-occ.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.48.1",
    "lucide-react": "^0.475.0",
    "next": "15.1.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.20.0",
    "eslint-config-next": "15.1.6",
    "eslint-config-prettier": "^10.0.1",
    "postcss": "^8.5.1",
    "prettier": "^3.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
